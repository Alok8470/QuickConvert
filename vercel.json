{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.quickconvert.in"
        }
      ],
      "destination": "https://quickconvert.in/:path*",
      "permanent": true
    }
  ]
}
